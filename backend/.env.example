# Server Port
PORT=5000

# MongoDB Connection String (Replace with your MongoDB Atlas or local MongoDB connection URI)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quizmaster?retryWrites=true&w=majority
# Example Local URI: mongodb://127.0.0.1:27017/quizmaster
MONGODB_URI=your_mongodb_atlas_connection_string

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://127.0.0.1:5500
